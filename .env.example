# Local PostgreSQL defaults
PGHOST=localhost
PGPORT=5432
PGDATABASE=unisubmit
PGUSER=unisubmit
PGPASSWORD=unisubmit

# Server
PORT=8080
APP_UPLOAD_DIR=uploads
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000

# Managed PostgreSQL providers such as Supabase may use a full JDBC URL.
# Example:
# JDBC_DATABASE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Password for the admin account created on a FRESH production database. Leave unset
# and one is generated at first boot and printed ONCE in the logs at WARN. Ignored once
# an 'admin' account exists. The demo trio (admin/lecturer/student, all password123) is
# local-profile-only and must never be switched on here.
ADMIN_INITIAL_PASSWORD=

# Password-reset codes (lecturers/admins only — students have no email, see
# UserService.createStudent; they still use the admin-mediated /forgot-password flow).
# Free option: a Gmail account + an App Password (myaccount.google.com/apppasswords) —
# no third-party signup, no per-message cost. Leave MAIL_USERNAME unset to run in
# log-only mode: the code is logged instead of emailed, useful for local dev.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
